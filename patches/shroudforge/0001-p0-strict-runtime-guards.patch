diff --git a/modules/entrypoints/windows-bootstrap/verify_bootstrap_image.h b/modules/entrypoints/windows-bootstrap/verify_bootstrap_image.h
new file mode 100644
index 0000000..c8960df
--- /dev/null
+++ b/modules/entrypoints/windows-bootstrap/verify_bootstrap_image.h
@@ -0,0 +1,55 @@
+#pragma once
+#include <windows.h>
+#include "sha256_digest.h"
+
+// P0 strict client-only policy pinned to profile 26082781 at 3ed90de1.
+// No settings/environment overrides; new binaries require explicit review/build.
+namespace StrictBuildIdentity {
+inline constexpr DWORD approved_timestamp=1792507660;
+inline constexpr DWORD approved_image_size=44163072;
+inline constexpr LONGLONG approved_file_size=35338312;
+inline constexpr std::array<std::uint8_t,32> approved_digest{
+    0xd6,0x49,0x66,0xe2,0x3b,0x1a,0x45,0x8e,0xe6,0xf1,0x47,0xbc,0xbc,0xea,0xc0,0xb5,
+    0x77,0xfa,0x7e,0x39,0xa2,0x12,0xf3,0x71,0x28,0x7d,0x8c,0xc1,0x19,0x81,0x78,0x82};
+// Keep the verified file open without write/delete sharing for the process lifetime.
+inline HANDLE verified_file=INVALID_HANDLE_VALUE;
+inline void Close() {
+    if (verified_file!=INVALID_HANDLE_VALUE) { CloseHandle(verified_file); verified_file=INVALID_HANDLE_VALUE; }
+}
+inline bool VerifyProcessImage() {
+    if (verified_file!=INVALID_HANDLE_VALUE) return false;
+    wchar_t path[32768]{};
+    const DWORD length=GetModuleFileNameW(nullptr,path,32768);
+    if (!length || length>=32768) return false;
+    HANDLE file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);
+    if (file==INVALID_HANDLE_VALUE) return false;
+    struct CloseOnFailure { HANDLE file; bool keep=false; ~CloseOnFailure(){ if(!keep) CloseHandle(file); } } guard{file};
+    LARGE_INTEGER size{};
+    if (!GetFileSizeEx(file,&size) || size.QuadPart!=approved_file_size) return false;
+    Sha256 hash;
+    std::uint8_t chunk[8192]{};
+    LONGLONG total=0;
+    for (;;) {
+        DWORD count{};
+        if (!ReadFile(file,chunk,sizeof(chunk),&count,nullptr)) return false;
+        if (!count) break;
+        total+=count;
+        if (total>approved_file_size) return false;
+        hash.update(chunk,count);
+    }
+    if (total!=approved_file_size || hash.finish()!=approved_digest) return false;
+    // Disk identity precedes dereferencing loaded PE metadata or any patch.
+    const auto* base=reinterpret_cast<const unsigned char*>(GetModuleHandleW(nullptr));
+    if (!base) return false;
+    const auto* dos=reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    if (dos->e_magic!=IMAGE_DOS_SIGNATURE || dos->e_lfanew<=0 || dos->e_lfanew>4096) return false;
+    const auto* nt=reinterpret_cast<const IMAGE_NT_HEADERS64*>(base+dos->e_lfanew);
+    if (nt->Signature!=IMAGE_NT_SIGNATURE || nt->FileHeader.Machine!=IMAGE_FILE_MACHINE_AMD64 ||
+        nt->OptionalHeader.Magic!=IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+        nt->FileHeader.TimeDateStamp!=approved_timestamp || nt->OptionalHeader.SizeOfImage!=approved_image_size)
+        return false;
+    verified_file=file;
+    guard.keep=true;
+    return true;
+}
+}

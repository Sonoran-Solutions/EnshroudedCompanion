+#!/usr/bin/env python3
+"""Compile production DllMain body with explicit non-Windows failure fixtures."""
+from pathlib import Path
+import subprocess
+import tempfile
+root=Path(__file__).resolve().parents[3]
+bootstrap=root/'modules/entrypoints/windows-bootstrap'
+text=(bootstrap/'startup.cpp').read_text()
+start=text.index('BOOL APIENTRY DllMain(')
+body=text[text.index('{',start):]
+# DllMain is the final definition in the production translation unit.
+assert body.rstrip().endswith('}')
+lifecycle=(bootstrap/'runtime_lifecycle.cpp').read_text()
+init=lifecycle.index('if (!EcsRuntime::Initialize())')
+assert init < lifecycle.index('start_modloader_ui(root);')
+assert init < lifecycle.index('start_world_editor_ui(root);')
+assert init < lifecycle.index('if (!prepare_startup(root.c_str()))') < lifecycle.index('startup.release();')
+source=r'''
+#include <cassert>
+#include <cstddef>
+#include <vector>
+using BOOL=int; using DWORD=unsigned; using HMODULE=void*; using LPVOID=void*; using HANDLE=void*;
+constexpr int TRUE=1, FALSE=0; constexpr unsigned DLL_PROCESS_ATTACH=1, DLL_PROCESS_DETACH=0;
+HMODULE self_module{}; HANDLE stop_event{},runtime_thread{};
+bool supported=true, verified=true,event_ok=true,gate_ok=true,thread_ok=true;
+unsigned verify_calls{},event_calls{},gate_calls{},thread_calls{},cancel_calls{},file_closes{},handle_closes{},signals{};
+bool file_open{}; std::vector<int> order;
+void DisableThreadLibraryCalls(HMODULE){}
+bool is_supported_game_process(){return supported;}
+namespace StrictBuildIdentity {
+ bool VerifyProcessImage(){++verify_calls;order.push_back(1);file_open=verified;return verified;}
+ void Close(){++file_closes;file_open=false;order.push_back(6);}
+}
+namespace StartupGate {
+ bool Install(){++gate_calls;order.push_back(3);return gate_ok;}
+ void CancelInstallation(){++cancel_calls;order.push_back(5);}
+}
+HANDLE CreateEventW(void*,BOOL,BOOL,void*){++event_calls;order.push_back(2);return event_ok?reinterpret_cast<HANDLE>(2):nullptr;}
+DWORD run(void*){return 0;}
+HANDLE CreateThread(void*,std::size_t,DWORD(*)(void*),void*,DWORD,void*){++thread_calls;order.push_back(4);return thread_ok?reinterpret_cast<HANDLE>(3):nullptr;}
+void CloseHandle(HANDLE handle){assert(handle);++handle_closes;}
+void SetEvent(HANDLE handle){assert(handle);++signals;}
+BOOL DllMain(HMODULE module,DWORD reason,LPVOID reserved) BODY
+void reset(){supported=verified=event_ok=gate_ok=thread_ok=true;verify_calls=event_calls=gate_calls=thread_calls=cancel_calls=file_closes=handle_closes=signals=0;file_open=false;stop_event=runtime_thread=nullptr;order.clear();}
+int main(){
+ reset();supported=false;assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==TRUE);assert(!verify_calls&&!event_calls&&!gate_calls&&!thread_calls);
+ reset();verified=false;assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==FALSE);assert(verify_calls==1&&!event_calls&&!gate_calls&&!thread_calls&&!file_open);
+ reset();event_ok=false;assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==FALSE);assert(event_calls==1&&!gate_calls&&!thread_calls&&file_closes==1&&!file_open);
+ reset();gate_ok=false;assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==FALSE);assert(gate_calls==1&&!thread_calls&&cancel_calls==1&&handle_closes==1&&file_closes==1&&!file_open&&!stop_event);
+ assert((order==std::vector<int>{1,2,3,5,6}));
+ reset();thread_ok=false;assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==FALSE);assert(thread_calls==1&&cancel_calls==1&&handle_closes==1&&file_closes==1&&!file_open&&!stop_event);
+ assert((order==std::vector<int>{1,2,3,4,5,6}));
+ reset();assert(DllMain(nullptr,DLL_PROCESS_ATTACH,nullptr)==TRUE);assert(file_open&&stop_event&&runtime_thread&&!cancel_calls&&!file_closes);
+ assert((order==std::vector<int>{1,2,3,4}));
+ assert(DllMain(nullptr,DLL_PROCESS_DETACH,nullptr)==TRUE);assert(signals==1&&file_closes==1&&!file_open);
+ reset();assert(DllMain(nullptr,DLL_PROCESS_DETACH,nullptr)==TRUE);assert(!signals&&file_closes==1);
+ reset();file_open=true;assert(DllMain(nullptr,DLL_PROCESS_DETACH,reinterpret_cast<void*>(1))==TRUE);assert(!signals&&!file_closes&&file_open);
+}
+'''.replace('BODY',body)
+with tempfile.TemporaryDirectory(prefix='p0-bootstrap-attach-') as tmp:
+ p=Path(tmp);cpp=p/'test.cpp';exe=p/'test';cpp.write_text(source)
+ subprocess.run(['g++','-std=c++20','-Wall','-Wextra','-Werror',str(cpp),'-o',str(exe)],check=True,timeout=30)
+ subprocess.run([str(exe)],check=True,timeout=30)
+print('PASS: production DllMain unknown-image/event/gate/thread failures, success, detach, cleanup order')
+print('PASS: static native-init before UI/prepare_startup and startup.release ordering')
+print('NOT_RUN: actual WinAPI file handles, loader lock, native gate rollback, Windows DLL/game acceptance')

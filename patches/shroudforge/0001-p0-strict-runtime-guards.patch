+#!/usr/bin/env python3
+"""Portable SHA known-answer checks; the actual header is compiled, not simulated."""
+from pathlib import Path
+import hashlib
+import subprocess
+import tempfile
+source=Path(__file__).with_name('hash_driver.cpp')
+with tempfile.TemporaryDirectory(prefix='p0-sha-') as temporary:
+    exe=Path(temporary)/'sha'
+    subprocess.run(['g++','-std=c++20','-Wall','-Wextra','-Werror',str(source),'-o',str(exe)],check=True,timeout=30)
+    vectors=[b'',b'abc',b'a'*1_000_000]
+    vectors += [bytes((i*37+11)%256 for i in range(n)) for n in [1,55,56,57,63,64,65,119,120,127,128,8192]]
+    for data in vectors:
+        actual=subprocess.run([str(exe)],input=data,capture_output=True,check=True,timeout=10).stdout.decode().strip()
+        assert actual==hashlib.sha256(data).hexdigest(),len(data)
+print(f'PASS: SHA-256 production header vs hashlib, {len(vectors)} vectors, incremental 7-byte updates')

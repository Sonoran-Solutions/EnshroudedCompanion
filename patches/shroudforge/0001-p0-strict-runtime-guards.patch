@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Build/run synthetic Windows guard fixtures in a fresh, disposable Wine prefix."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--cxx',required=True)
+parser.add_argument('--wine',required=True)
+parser.add_argument('--wineserver',required=True)
+a=parser.parse_args()
+source=Path(__file__).resolve().parent
+bootstrap=source.parents[2]/'modules/entrypoints/windows-bootstrap'
+
+def build(*args):
+    subprocess.run([a.cxx,'-std=c++20','-static',*map(str,args)],check=True,timeout=30)
+
+with tempfile.TemporaryDirectory(prefix='p0-windows-guards-') as tmp:
+    tmp=Path(tmp)
+    prefix=tmp/'prefix'; prefix.mkdir()
+    env={**os.environ,'WINEPREFIX':str(prefix),'WINEDEBUG':'-all'}
+    env.pop('SF_GATE_TEST_FAIL',None)
+    def run(exe,expected=0,fail=False):
+        test_env={**env}
+        if fail: test_env['SF_GATE_TEST_FAIL']='1'
+        result=subprocess.run([a.wine,str(exe)],env=test_env,capture_output=True,text=True,timeout=30)
+        assert result.returncode==expected,(exe.name,result.returncode,result.stdout,result.stderr)
+        print(f'PASS: {exe.name}, preparation_failure={fail}, exit={result.returncode}')
+    try:
+        unknown=tmp/'unknown.exe'
+        build(source/'unknown_image.cpp','-o',unknown)
+        run(unknown)
+        padded=tmp/'unknown-same-size.exe'
+        padded.write_bytes(unknown.read_bytes())
+        with padded.open('ab') as stream: stream.truncate(35338312)
+        run(padded)
+        library=tmp/'startup_gate_test.dll'; imports=tmp/'libstartup_gate_test.a'
+        build('-shared',bootstrap/'tests/startup_gate_dll.cpp','-o',library,f'-Wl,--out-implib,{imports}')
+        gate=tmp/'startup_gate_test.exe'
+        build(bootstrap/'tests/startup_gate_exe.cpp',imports,'-o',gate)
+        run(gate)
+        run(gate,expected=1114%256,fail=True)
+        cancel=tmp/'cancel'; cancel.mkdir()
+        imports=cancel/'libstartup_gate_test.a'
+        build('-shared',source/'gate_cancel_dll.cpp','-o',cancel/'startup_gate_test.dll',f'-Wl,--out-implib,{imports}')
+        build(bootstrap/'tests/startup_gate_exe.cpp',imports,'-o',cancel/'startup_gate_test.exe')
+        run(cancel/'startup_gate_test.exe')
+    finally:
+        # This prefix is created by this job and never points at a game/user prefix.
+        stopped=subprocess.run([a.wineserver,'-k'],env=env,timeout=10)
+        # Exit 1 also means the per-prefix server already exited after its clients.
+        if stopped.returncode not in (0,1):
+            raise RuntimeError(f'wineserver cleanup failed: {stopped.returncode}')
+        subprocess.run([a.wineserver,'-w'],env=env,check=True,timeout=10)
+print('NOT_RUN: production DLL bundle and Enshrouded; no game files or prefix used')

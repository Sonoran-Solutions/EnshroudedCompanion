+#!/usr/bin/env python3
+"""Compile unchanged production guard expressions/lifecycle bodies against explicit fixtures.
+Does not compile the Windows DLL or prove signature recovery on a game binary.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[3]
+native = root / 'modules/game-runtime/native'
+def body(path, signature):
+    text = path.read_text()
+    start = text.index(signature)
+    brace = text.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[brace:end]
+profile = (native / 'profiles/select_game_profile.cpp').read_text()
+start = profile.index('const bool matches =')
+match = profile[start:profile.index(';', start)+1]
+assert 'fallback_profile' not in profile and 'allowStructuralRevalidation' not in profile
+assert 'exact_count != 1' in profile
+assert 'exact_build_match = false;' in profile.split('catch (const std::exception& error)')[1]
+ecs_body = body(native / 'ecs/bind_world_entities.cpp', 'bool Initialize()')
+provider_body = body(native / 'host/manage_runtime_lifecycle.cpp', 'KFC_RUNTIME_API bool __cdecl KfcRuntimeInitialize()')
+source = r'''
+#include <cassert>
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <stdexcept>
+#include <string>
+struct Json {
+ std::map<std::string, Json> children; std::string text; unsigned number{};
+ const Json& at(const std::string& key) const { return children.at(key); }
+ bool contains(const std::string& key) const { return children.count(key); }
+ template<class T> T get() const { return text; }
+ bool operator==(unsigned value) const { return number == value; }
+};
+struct Nt { struct { unsigned TimeDateStamp; } FileHeader; struct { unsigned SizeOfImage; } OptionalHeader; } nt_value{{10},{20}};
+bool matches(const Json& candidate, const std::string& process_hash) {
+ auto nt = &nt_value;
+ MATCH
+ return matches;
+}
+namespace ecs_test {
+struct IMAGE_DOS_HEADER { unsigned e_magic; int e_lfanew; };
+struct IMAGE_NT_HEADERS64 { unsigned Signature; struct { unsigned SizeOfImage; } OptionalHeader; };
+struct Image { IMAGE_DOS_HEADER dos; IMAGE_NT_HEADERS64 nt; } image;
+constexpr unsigned IMAGE_DOS_SIGNATURE=123, IMAGE_NT_SIGNATURE=456;
+std::uintptr_t image_base{}; unsigned image_size{};
+std::atomic<bool> stop_requested{true};
+bool have_module=true, load_ok=true, hook_ok=true;
+unsigned shutdowns{}, installs{};
+void* GetModuleHandleW(void*) { return have_module ? &image : nullptr; }
+namespace KfcRuntimeCompatibility::EnshroudedClient { bool Load(){ return load_ok; } }
+namespace EngineHooks { bool Install(){ ++installs; return hook_ok; } }
+void Shutdown(){ ++shutdowns; stop_requested=true; }
+bool Initialize() ECS_BODY
+void reset(){ image.dos={IMAGE_DOS_SIGNATURE, sizeof(IMAGE_DOS_HEADER)}; image.nt={IMAGE_NT_SIGNATURE,{88}}; have_module=load_ok=hook_ok=true; shutdowns=installs=0; stop_requested=false; }
+void test(){
+ reset(); load_ok=false; assert(!Initialize() && installs==0 && stop_requested);
+ reset(); have_module=false; assert(!Initialize() && installs==0 && stop_requested);
+ reset(); image.dos.e_magic=0; assert(!Initialize() && installs==0 && stop_requested);
+ reset(); image.nt.Signature=0; assert(!Initialize() && installs==0 && stop_requested);
+ reset(); hook_ok=false; assert(!Initialize() && installs==1 && shutdowns==2 && stop_requested);
+ reset(); assert(Initialize() && installs==1 && !stop_requested);
+}
+}
+namespace provider_test {
+std::atomic<bool> provider_initialized{true};
+bool ecs_ok=true, resource_ok=true, throws=false;
+unsigned ecs_stops{}, resource_stops{}, resource_starts{};
+namespace EcsRuntime { bool Initialize(){ if(throws) throw std::runtime_error("fixture"); return ecs_ok; } void Shutdown(){ ++ecs_stops; } }
+namespace ResourceRuntime { bool Initialize(){ ++resource_starts; return resource_ok; } void Shutdown(){ ++resource_stops; } }
+bool Initialize() PROVIDER_BODY
+void reset(){ ecs_ok=resource_ok=true; throws=false; ecs_stops=resource_stops=resource_starts=0; provider_initialized=true; }
+void test(){
+ reset(); ecs_ok=false; assert(!Initialize() && !provider_initialized && resource_starts==0 && ecs_stops==1 && resource_stops==1);
+ reset(); resource_ok=false; assert(!Initialize() && !provider_initialized && ecs_stops==1 && resource_stops==1);
+ reset(); throws=true; assert(!Initialize() && !provider_initialized && ecs_stops==1 && resource_stops==1);
+ reset(); assert(Initialize() && provider_initialized && resource_starts==1);
+}
+}
+int main(){
+ Json candidate; auto& image=candidate.children["image"]; image.children["timestamp"].number=10; image.children["size"].number=20;
+ const std::string hash(64,'a');
+ assert(!matches(candidate,hash));
+ image.children["sha256"].text=hash; assert(matches(candidate,hash));
+ assert(!matches(candidate,"")); assert(!matches(candidate,std::string(64,'b')));
+ image.children["timestamp"].number=11; assert(!matches(candidate,hash)); image.children["timestamp"].number=10;
+ image.children["size"].number=21; assert(!matches(candidate,hash));
+ ecs_test::test(); provider_test::test();
+}
+'''.replace('MATCH', match).replace('ECS_BODY', ecs_body).replace('PROVIDER_BODY', provider_body)
+with tempfile.TemporaryDirectory(prefix='p0-strict-guards-') as tmp:
+    cpp=Path(tmp)/'test.cpp'; exe=Path(tmp)/'test'; cpp.write_text(source)
+    subprocess.run(['g++','-std=c++20','-Wall','-Wextra','-Werror',str(cpp),'-o',str(exe)], check=True,timeout=30)
+    subprocess.run([str(exe)],check=True,timeout=30)
+print('PASS: production SHA/PE predicate, ECS required-hook propagation, provider failure/exception cleanup fixtures')
+print('NOT_RUN: Windows DLL build, actual symbol scan, startup entrypoint guard, game/runtime acceptance')
